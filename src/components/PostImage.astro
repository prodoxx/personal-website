---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// Renders Markdown images in MDX posts as <picture>: WebP first, with the
// source format as the fallback for browsers without WebP support.
type Props = {
  src: ImageMetadata | string;
  alt: string;
  title?: string;
};

const { src, alt, title } = Astro.props;
---

{
  typeof src === "string" ? (
    <img src={src} alt={alt} title={title} loading="lazy" decoding="async" />
  ) : (
    <Picture
      src={src}
      alt={alt}
      title={title}
      formats={["webp"]}
      sizes="(min-width: 672px) 632px, calc(100vw - 40px)"
    />
  )
}
