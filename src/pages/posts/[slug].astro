---
import { getImage } from "astro:assets";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PostImage from "../../components/PostImage.astro";
import Base from "../../layouts/Base.astro";
import { formatDate, getPublishedPosts, readingMinutes } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"posts"> };

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body ?? "");

// Social platforms expect a 1200x630 share image. Meta tags cannot offer
// format fallbacks like <picture>, so use PNG, which every platform renders.
const shareImage = post.data.image
  ? await getImage({ src: post.data.image, width: 1200, height: 630, format: "png" })
  : undefined;
const image = shareImage && {
  src: shareImage.src,
  width: 1200,
  height: 630,
  alt: post.data.imageAlt ?? post.data.title,
};

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    "@type": "Person",
    name: "Reggie Escobar",
    url: "https://reggieescobar.com/",
  },
  mainEntityOfPage: new URL(`/posts/${post.id}/`, Astro.site).href,
  ...(image && { image: new URL(image.src, Astro.site).href }),
});
---

<Base
  title={`${post.data.title} | Reggie Escobar`}
  description={post.data.description}
  ogType="article"
  image={image}
>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <article>
    <a href="/posts/" class="text-sm font-medium text-amber-800 hover:underline">← Posts</a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900">
      {post.data.title}
    </h1>
    <p class="mt-2 text-sm text-zinc-500">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true"> · </span>
      <span>{minutes} min read</span>
    </p>
    <div
      class="prose prose-zinc mt-8 max-w-none prose-a:text-amber-800 prose-a:decoration-amber-800/40 prose-a:underline-offset-2 prose-a:hover:decoration-amber-800 prose-img:rounded-xl prose-img:border prose-img:border-zinc-200"
    >
      <Content components={{ img: PostImage }} />
    </div>
  </article>
</Base>
